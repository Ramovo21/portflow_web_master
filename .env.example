# Copy to .env.local to override.

# Where the Vite dev server forwards /api/* (dev only, not exposed to the browser).
API_PROXY_TARGET=http://localhost:8080

# Base URL the browser uses for API calls. Keep "/api" to go through the proxy / same-origin
# reverse proxy. Set a full URL (e.g. http://localhost:8080/api) to call the backend directly —
# then the backend's CORS allowed-origins must include this UI's origin.
VITE_API_BASE_URL=/api

# Keycloak realm (OIDC issuer) and the public SPA client (Authorization Code + PKCE).
VITE_OIDC_AUTHORITY=http://localhost:8180/realms/portflow
VITE_OIDC_CLIENT_ID=portflow-web

# (Tùy chọn) Link "Mở Keycloak" ở trang Người dùng. Mặc định: <origin>/admin/master/console/#/<realm>/users
# (đăng nhập bằng tài khoản quản trị Keycloak, không phải user PortFlow).
# VITE_KEYCLOAK_ADMIN_CONSOLE_URL=
